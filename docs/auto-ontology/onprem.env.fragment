# --- auto-ontology against an on-premise endpoint ------------------------------------
# Fill in the base URL of the OpenAI-compatible NIM. Nothing here reaches a cloud.
# ONPREM_BASE is only used by this fragment; auto-ontology reads the triplets below.
#   e.g. ONPREM_BASE=http://<host>:8000/v1
ONPREM_BASE=http://REPLACE-ME:8000/v1
ONPREM_KEY=not-needed-but-must-be-non-empty

# The default triplet: every other triplet falls back to this one field by field.
DEFAULT_MODELS_ENDPOINT=${ONPREM_BASE}
DEFAULT_MODELS_API_KEY=${ONPREM_KEY}
DEFAULT_MODELS_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Reasoning and non-reasoning inherit the default; named explicitly so a later
# change to one of them does not quietly move the other.
REASONING_ENDPOINT=${ONPREM_BASE}
REASONING_API_KEY=${ONPREM_KEY}
REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NON_REASONING_ENDPOINT=${ONPREM_BASE}
NON_REASONING_API_KEY=${ONPREM_KEY}
NON_REASONING_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Embeddings are a separate model and MUST be set: an unset field falls back to
# the chat model above, which would be sent to /v1/embeddings and fail. The same
# model has to serve ingestion and every later query - the vectors are compared.
EMBED_ENDPOINT=${ONPREM_BASE}
EMBED_API_KEY=${ONPREM_KEY}
EMBED_MODEL=REPLACE-ME-WITH-THE-EMBEDDING-MODEL

# Reranking is optional in practice: utils/rerank.py raises on an endpoint error and
# its one caller (semantic/bridge_tables.py, picking the owner of a bridge table)
# logs and falls back to the first candidate term. Leave it pointed at the on-prem
# base and it gets /v1/ranking appended; if nothing serves that, the fallback runs.
RERANK_ENDPOINT=${ONPREM_BASE}
RERANK_API_KEY=${ONPREM_KEY}
RERANK_MODEL=REPLACE-ME-OR-LEAVE-TO-FAIL-SOFT

# The source: a copy of the pack's own store, mounted read-only. Public EBA
# material only - 1830 PAY datapoints, 93 terms, the rules. No reported figures.
CONNECTION_STRINGS=duckdb:///data/pay42.duckdb

# Predictive routing to the hosted KumoRFM service stays off: no KUMO_RFM_API_KEY.
