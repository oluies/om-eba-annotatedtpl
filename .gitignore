# Intermediate artefacts of the extraction pipeline; regenerate with source/extract_dpm.py.
source/dpm.json
source/vocab.json

.venv/
__pycache__/
.ruff_cache/
*.pyc
.env

# Derived store; rebuild with source/build_duckdb.py
pay42.duckdb

# Local copy of the EBA DPM 2.0 database; download with source/fetch_dpm2.py
source/dpm2/

# The parquet tree for a browser; rebuild with source/gen_wasm_data.py
web/public/data/

# Scala.js output and its caches. The cache lands next to the sources scala-cli was
# pointed at - web/src/dpm/.scala-build - not at the project root, so this matches it
# anywhere rather than in the one place it was expected.
web/public/main.js
web/public/main.js.map
.scala-build/
.bsp/
web/server.log

# The Quarto spike's output, and the per-template pages that produce it. Both are
# generated by quarto/render.sh from the DPM database, so neither is a source: the page
# for a template is four lines of front matter around an include.
quarto/_site/
quarto/_md/
quarto/[A-Z]_*.qmd
quarto/[A-Z][A-Z]*.qmd
quarto/.quarto/
